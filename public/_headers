# Applied by Cloudflare to the files in dist/: https://developers.cloudflare.com/workers/static-assets/headers/

# What a <meta> Content Security Policy cannot say: no other site may frame the game.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro names these files by a hash of their content, so a changed file gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
