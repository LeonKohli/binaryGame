{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binary-game",
  "compatibility_date": "2026-10-12",
  // Every page is prerendered, so the Worker only serves the build output. Pages build to
  // /path/index.html; the default html_handling redirects /path to /path/.
  // https://developers.cloudflare.com/workers/static-assets/routing/static-site-generation/
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "binary.leonkohli.dev", "custom_domain": true }],
}
